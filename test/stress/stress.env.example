# ============================================
# mRWA Stress Test — Fork Mode Configuration
# ============================================
# 使用方法:
#   1. 复制本文件: cp stress.env.example stress.env
#   2. 填入实际合约地址
#   3. 运行: ./test/stress/run_stress.sh fork
#   或手动: source test/stress/stress.env && forge test --match-contract S1_ -vvv

# --- 通用参数 ---
STRESS_ROUNDS=50
STRESS_USERS=20
STRESS_SEED=12345
STRESS_DAYS=30

# --- Fork 模式开关 ---
STRESS_FORK=true
STRESS_RPC_URL=https://rpc.sepolia.mantle.xyz

# --- 合约地址（Mantle Sepolia 示例，请替换为实际部署地址）---
STRESS_VAULT=0xa2a35f68b61b1280959fd91e9d8750a95366b969
STRESS_GATEWAY=0x30650357bf43cca867dcb65e90b3059e9e5fe561
