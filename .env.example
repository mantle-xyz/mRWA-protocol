# ============================================
# Etherscan / Block Explorer
# ============================================
ETHERSCAN_API_KEY=

# ============================================
# DeployVault.s.sol — Deployment
# ============================================
# Signing: set PRIVATE_KEY *or* ADDRESS (Ledger).
# If both are set, private key takes priority.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

USDC_ADDRESS=
SANCTIONS_ORACLE=
CONTROLLER=
ACCOUNTANT=
TREASURY=
PAUSER=
MAX_REDEMPTION_FEE_BPS=500
MAX_RATE_CHANGE_BPS=1000
REDEMPTION_FEE_BPS=100
MIN_REDEEM_AMOUNT=10000000
SYNC_REDEEM_DISABLED=false

# ============================================
# Interact.s.sol — Post-deployment interaction
# ============================================
VAULT_ADDRESS=

# User signing: set PRIVATE_KEY *or* ADDRESS (Ledger)
USER_PRIVATE_KEY=
USER_ADDRESS=
DEPOSIT_AMOUNT=1000000000
REDEEM_SHARES=1000000000

# Controller signing: set PRIVATE_KEY *or* ADDRESS (Ledger)
CONTROLLER_PRIVATE_KEY=
CONTROLLER_ADDRESS=
REQUEST_IDS=1,2,3
SETTLED_AMOUNTS=990000000,495000000,247500000